From 06de84fe8dd5c8f62292ef215538bd07e5d3fee2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Otto=20Pfl=C3=BCger?= <otto.pflueger@abscue.de>
Date: Thu, 20 Apr 2023 18:45:03 +0200
Subject: [PATCH 10/11] ASoC: qdsp6: q6voice-dai: Add VoiceMMode1 DAI
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

VoiceMMode1 is used instead of CS-Voice on newer firmwares.

Signed-off-by: Otto Pflüger <otto.pflueger@abscue.de>
---
 include/dt-bindings/sound/qcom,q6voice.h |   7 +
 sound/soc/qcom/qdsp6/q6mvm.c             |  14 ++
 sound/soc/qcom/qdsp6/q6voice-dai.c       | 184 +++++++++++++++++++----
 sound/soc/qcom/qdsp6/q6voice.h           |  16 +-
 4 files changed, 180 insertions(+), 41 deletions(-)

diff --git a/include/dt-bindings/sound/qcom,q6voice.h b/include/dt-bindings/sound/qcom,q6voice.h
index fe5aa3a3fce49b..0d0a718c55bd40 100644
--- a/include/dt-bindings/sound/qcom,q6voice.h
+++ b/include/dt-bindings/sound/qcom,q6voice.h
@@ -3,5 +3,12 @@
 #define __DT_BINDINGS_Q6_VOICE_H__
 
 #define	CS_VOICE        0
+#define	VOIP            1
+#define	VOLTE           1
+#define	VOICE2          1
+#define	QCHAT           1
+#define	VOWLAN          1
+#define	VOICEMMODE1     1
+#define	VOICEMMODE2     2
 
 #endif /* __DT_BINDINGS_Q6_VOICE_H__ */
diff --git a/sound/soc/qcom/qdsp6/q6mvm.c b/sound/soc/qcom/qdsp6/q6mvm.c
index f1f8d520ba0d9b..ace0d9ca302572 100644
--- a/sound/soc/qcom/qdsp6/q6mvm.c
+++ b/sound/soc/qcom/qdsp6/q6mvm.c
@@ -51,6 +51,20 @@ static inline const char *q6mvm_session_name(enum q6voice_path_type path)
 	switch (path) {
 	case Q6VOICE_PATH_VOICE:
 		return "default modem voice";
