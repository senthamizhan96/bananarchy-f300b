+static bool adreno_has_display_node(void)
+{
+	static const char * const compat[] = {
+		"qcom,mdss",
+		"qcom,mdp4",
+		"qcom,mdp5",
+		"qcom,dpu1",
+	};
+	struct device_node *np;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(compat); i++) {
+		np = of_find_compatible_node(NULL, NULL, compat[i]);
+		if (np) {
+			bool avail = of_device_is_available(np);
+			of_node_put(np);
+			if (avail)
+				return true;
+		}
+	}
+	return false;
 }
 
