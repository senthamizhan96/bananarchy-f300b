+void T9State::sendItem(const T9Item& item) {
+  if (ctrlLatch && !item.commitText.empty()) {
+    fcitx::KeySym cSym = FcitxKey_None;
+    uint32_t cCode = 0;
+    ctrlLatch = false;
+    if (charToCtrlKey(item.commitText[0], &cSym, &cCode)) {
+      forwardKeyTap(cSym, fcitx::KeyState::Ctrl, cCode);
+      return;
+    }
+  }
+  ctrlLatch = false;
+  if (item.sym != FcitxKey_None) {
+    forwardKeyTap(item.sym, item.states, item.xkbCode);
+  } else if (!item.commitText.empty()) {
+    ic->commitString(item.commitText);
+    if (mode == T9Mode::Shift &&
+        std::isalpha(static_cast<unsigned char>(item.commitText[0]))) {
+      mode = T9Mode::Lower;
+    }
+  }
