+int mapHardwareKey(const fcitx::Key& key) {
+  uint32_t code = key.code();
+  // XKB keycodes: KEY_1..KEY_9 = 10..18, KEY_0 = 19
+  if (code >= 10 && code <= 19) {
+    return static_cast<int>(code - 9);
+  }
+  // KEY_NUMERIC_STAR (evdev 522 -> XKB 530)
+  if (code == 530 || key.sym() == FcitxKey_asterisk ||
+      static_cast<uint32_t>(key.sym()) == 0x1008ffaa) {
+    return kKeyStar;
+  }
+  // KEY_NUMERIC_POUND (evdev 523 -> XKB 531)
+  if (code == 531 || key.sym() == FcitxKey_numbersign ||
+      static_cast<uint32_t>(key.sym()) == 0x1008ffab) {
+    return kKeyPound;
+  }
+  return -1;
+}
