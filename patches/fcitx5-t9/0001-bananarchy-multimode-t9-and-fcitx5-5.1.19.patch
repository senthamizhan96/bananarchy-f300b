+void T9State::forwardKeyTap(fcitx::KeySym sym, fcitx::KeyStates states,
+                            uint32_t xkbCode) {
+  if (states.test(fcitx::KeyState::Ctrl)) {
+    constexpr uint32_t kXkbModCtrl = (1u << 2);
+    sendWaylandVkModifiers(ic, kXkbModCtrl);
+    ic->forwardKey(fcitx::Key(sym, fcitx::KeyState::Ctrl, xkbCode), false);
+    sendWaylandVkModifiers(ic, 0u);
+  } else {
+    ic->forwardKey(fcitx::Key(sym, states, xkbCode), false);
+  }
+}
