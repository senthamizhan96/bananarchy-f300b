+void T9State::onLongPress(int keyId) {
+  isLongPressHandled = true;
+  if (!activeItems.empty()) {
+    commit();
+  }
+  if (keyId >= kKey1 && keyId <= kKey9) {
+    sendItem(makeChar(static_cast<char>('0' + keyId)));
+    resetUI();
+  } else if (keyId == kKey0) {
+    sendItem(makeChar('0'));
+    resetUI();
+  } else if (keyId == kKeyStar) {
+    if (mode == T9Mode::Num) {
+      sendItem(makeChar('.'));
+      resetUI();
+    } else {
+      ctrlLatch = !ctrlLatch;
+      showStatusBanner(ctrlLatch ? "[Ctrl+ LATCH ON]" : "[Ctrl+ LATCH OFF]");
     }
+  } else if (keyId == kKeyPound) {
+    sendItem(makeChar('#'));
+    resetUI();
+  }
+}
