+void sendWaylandVkModifiers(fcitx::InputContext* ic, uint32_t modsDepressed) {
+  if (!ic || ic->frontendName() != std::string_view("wayland_v2")) {
+    return;
+  }
+  static void* wlHandle = dlopen("libwayland-client.so.0", RTLD_LAZY);
+  static auto getVer =
+      wlHandle ? reinterpret_cast<WlProxyGetVersionFn>(
+                     dlsym(wlHandle, "wl_proxy_get_version"))
+               : nullptr;
+  static auto marshalFlags =
+      wlHandle ? reinterpret_cast<WlProxyMarshalFlagsFn>(
+                     dlsym(wlHandle, "wl_proxy_marshal_flags"))
+               : nullptr;
+  if (!getVer || !marshalFlags) {
+    return;
+  }
+  auto* raw = reinterpret_cast<uint8_t*>(ic);
+  std::string_view typeName(typeid(*ic).name());
+  if (typeName.find("VirtualInputContext") != std::string_view::npos) {
+    raw = *reinterpret_cast<uint8_t**>(raw + 3 * sizeof(void*));
+    if (!raw) {
+      return;
+    }
+  }
+  if (!raw[54]) {
+    return;
+  }
+  void* vkObj = *reinterpret_cast<void**>(raw + 40);
+  if (!vkObj) {
+    return;
+  }
+  auto* proxy = *reinterpret_cast<struct wl_proxy**>(
+      reinterpret_cast<uint8_t*>(vkObj) + 2 * sizeof(void*));
+  if (!proxy) {
+    return;
+  }
+  constexpr uint32_t kZwpVirtualKeyboardV1ModifiersOpcode = 2;
+  uint32_t ver = getVer(proxy);
+  marshalFlags(proxy, kZwpVirtualKeyboardV1ModifiersOpcode, nullptr, ver, 0,
+               modsDepressed, 0u, 0u, 0u);
+}
