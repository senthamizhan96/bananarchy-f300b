+void T9State::handleMultiTap(int keyId) {
+  if (bannerTimer) {
+    bannerTimer.reset();
+  }
+  if (lastKeyId != -1 && keyId != lastKeyId) {
+    commit();
+  }
+  if (keyId == lastKeyId && !activeItems.empty()) {
+    currentIndex = (currentIndex + 1) % static_cast<int>(activeItems.size());
+  } else {
+    activeItems = getItemsForKey(keyId);
+    currentIndex = 0;
+    lastKeyId = keyId;
   }
+  if (activeItems.empty()) {
+    return;
+  }
+  uint64_t delayUs = (activeItems.size() > 10) ? 750000 : 600000;
+  scheduleCommit(delayUs);
+  showPreview(activeItems, currentIndex);
