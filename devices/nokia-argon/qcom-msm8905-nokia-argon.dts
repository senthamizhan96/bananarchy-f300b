/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;
	model = "Nokia 8110 4G";
	compatible = "nokia,argon", "qcom,msm8905", "qcom,msm8909";
	chassis-type = "handset";

	aliases {
		mmc0 = "/soc@0/sdhci@7824000";
		mmc1 = "/soc@0/sdhci@7864000";
		serial0 = "/soc@0/serial@78af000";
	};

	chosen {
		stdout-path = "serial0";
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			phandle = <0x18>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			phandle = <0x28>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x00>;
			next-level-cache = <0x02>;
			enable-method = "qcom,msm8909-smp";
			clocks = <0x03>;
			#cooling-cells = <0x02>;
			power-domains = <0x04 0x01>;
			power-domain-names = "perf";
			operating-points-v2 = <0x05>;
			cpu-idle-states = <0x06>;
			qcom,acc = <0x07>;
			qcom,saw = <0x08>;
			phandle = <0x80>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x01>;
			next-level-cache = <0x02>;
			enable-method = "qcom,msm8909-smp";
			clocks = <0x03>;
			#cooling-cells = <0x02>;
			power-domains = <0x04 0x01>;
			power-domain-names = "perf";
			operating-points-v2 = <0x05>;
			cpu-idle-states = <0x06>;
			qcom,acc = <0x09>;
			qcom,saw = <0x0a>;
			phandle = <0x81>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x02>;
			next-level-cache = <0x02>;
			enable-method = "qcom,msm8909-smp";
			clocks = <0x03>;
			#cooling-cells = <0x02>;
			power-domains = <0x04 0x01>;
			power-domain-names = "perf";
			operating-points-v2 = <0x05>;
			cpu-idle-states = <0x06>;
			qcom,acc = <0x0b>;
			qcom,saw = <0x0c>;
			phandle = <0x82>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x03>;
			next-level-cache = <0x02>;
			enable-method = "qcom,msm8909-smp";
			clocks = <0x03>;
			#cooling-cells = <0x02>;
			power-domains = <0x04 0x01>;
			power-domain-names = "perf";
			operating-points-v2 = <0x05>;
			cpu-idle-states = <0x06>;
			qcom,acc = <0x0d>;
			qcom,saw = <0x0e>;
			phandle = <0x83>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			phandle = <0x02>;
		};

		idle-states {

			cpu-sleep-0 {
				compatible = "qcom,idle-state-spc";
				idle-state-name = "standalone-power-collapse";
				entry-latency-us = <0xb4>;
				exit-latency-us = <0xf0>;
				min-residency-us = <0x4ec>;
				local-timer-stop;
				phandle = <0x06>;
			};
		};
	};

	cpu-opp-table {
		compatible = "operating-points-v2-kryo-cpu", "operating-points-v2";
		nvmem-cells = <0x0f>;
		opp-shared;
		phandle = <0x05>;

		opp-199999951 {
			opp-hz = <0x00 0xbebc1cf>;
			required-opps = <0x10>;
			opp-supported-hw = <0xff>;
		};

		opp-399999902 {
			opp-hz = <0x00 0x17d7839e>;
			required-opps = <0x11>;
			opp-supported-hw = <0xff>;
		};

		opp-533333202 {
			opp-hz = <0x00 0x1fca04d2>;
			required-opps = <0x11>;
			opp-supported-hw = <0xff>;
		};

		opp-799999804 {
			opp-hz = <0x00 0x2faf073c>;
			required-opps = <0x12>;
			opp-supported-hw = <0xff>;
		};

		opp-998400000 {
			opp-hz = <0x00 0x3b826000>;
			required-opps = <0x12>;
			opp-supported-hw = <0x05>;
		};

		opp-1094400000 {
			opp-hz = <0x00 0x413b3800>;
			required-opps = <0x13>;
			opp-supported-hw = <0x05>;
		};

		opp-1248000000 {
			opp-hz = <0x00 0x4a62f800>;
			required-opps = <0x13>;
			opp-supported-hw = <0x01>;
		};

		opp-1267200000 {
			opp-hz = <0x00 0x4b87f000>;
			required-opps = <0x13>;
			opp-supported-hw = <0x01>;
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-msm8916", "qcom,scm";
			clocks = <0x14 0x3d 0x14 0x3f 0x14 0x3e>;
			clock-names = "core", "bus", "iface";
			qcom,dload-mode = <0x15 0x6100>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x00>;
	};

	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <0x01 0x07 0xf04>;
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		tz-apps@87a00000 {
			reg = <0x87a00000 0x200000>;
			no-map;
		};

		rfsa@87ce0000 {
			reg = <0x87ce0000 0x20000>;
			no-map;
		};

		smem@87d00000 {
			compatible = "qcom,smem";
			reg = <0x87d00000 0x100000>;
			no-map;
			hwlocks = <0x16 0x03>;
			qcom,rpm-msg-ram = <0x17>;
		};

		tz@87e00000 {
			reg = <0x87e00000 0x200000>;
			no-map;
		};

		mpss@88000000 {
			reg = <0x88000000 0x5500000>;
			no-map;
			phandle = <0x36>;
		};

		wcnss@8d500000 {
			reg = <0x8d500000 0x700000>;
			no-map;
			phandle = <0x74>;
		};

		mba@8dc00000 {
			reg = <0x8dc00000 0x100000>;
			no-map;
			phandle = <0x35>;
		};

		rmtfs@9f700000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x9f700000 0x300000>;
			no-map;
			qcom,client-id = <0x01>;
		};
	};

	smd {
		compatible = "qcom,smd";

		rpm {
			interrupts = <0x00 0xa8 0x01>;
			qcom,ipc = <0x03 0x08 0x00>;
			qcom,smd-edge = <0x0f>;

			rpm-requests {
				compatible = "qcom,rpm-msm8909";
				qcom,smd-channels = "rpm_requests";

				clock-controller {
					compatible = "qcom,rpmcc-msm8909", "qcom,rpmcc";
					#clock-cells = <0x01>;
					clocks = <0x18>;
					clock-names = "xo";
					phandle = <0x78>;
				};

				power-controller {
					compatible = "qcom,msm8909-rpmpd";
					#power-domain-cells = <0x01>;
					operating-points-v2 = <0x19>;
					phandle = <0x04>;

					opp-table {
						compatible = "operating-points-v2";
						phandle = <0x19>;

						opp1 {
							opp-level = <0x01>;
							phandle = <0x10>;
						};

						opp2 {
							opp-level = <0x02>;
						};

						opp3 {
							opp-level = <0x03>;
							phandle = <0x11>;
						};

						opp4 {
							opp-level = <0x04>;
							phandle = <0x12>;
						};

						opp5 {
							opp-level = <0x05>;
						};

						opp6 {
							opp-level = <0x06>;
							phandle = <0x13>;
						};
					};
				};

				pm8909-regulators {
					compatible = "qcom,rpm-pm8909-regulators";

					s2 {
						regulator-min-microvolt = <0x1c3a90>;
						regulator-max-microvolt = <0x1c3a90>;
						phandle = <0x30>;
					};

					l1 {
						regulator-min-microvolt = <0xf4240>;
						regulator-max-microvolt = <0xf4240>;
					};

					l2 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
					};

					l4 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l5 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x2f>;
					};

					l6 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x6d>;
					};

					l7 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x34>;
					};

					l8 {
						regulator-min-microvolt = <0x2b7cd0>;
						regulator-max-microvolt = <0x2c4020>;
						phandle = <0x49>;
					};

					l9 {
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x7a>;
					};

					l10 {
						regulator-min-microvolt = <0x12b128>;
						regulator-max-microvolt = <0x13d620>;
						phandle = <0x79>;
					};

					l11 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-system-load = <0x30d40>;
						regulator-allow-set-load;
						phandle = <0x50>;
					};

					l12 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2d0370>;
						phandle = <0x51>;
					};

					l13 {
						regulator-min-microvolt = <0x2eebb8>;
						regulator-max-microvolt = <0x2eebb8>;
						phandle = <0x31>;
					};

					l14 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2dc6c0>;
					};

					l15 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2dc6c0>;
					};

					l17 {
						regulator-min-microvolt = <0x2b7cd0>;
						regulator-max-microvolt = <0x2b7cd0>;
						phandle = <0x6c>;
					};

					l18 {
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x2932e0>;
					};
				};
			};
		};
	};

	smp2p-hexagon {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupts = <0x00 0x1b 0x01>;
		qcom,ipc = <0x03 0x08 0x0e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x33>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x32>;
		};
	};

	smp2p-wcnss {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1c3 0x1af>;
		interrupts = <0x00 0x8f 0x01>;
		qcom,ipc = <0x03 0x08 0x12>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x04>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x76>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x75>;
		};
	};

	smsm {
		compatible = "qcom,smsm";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		qcom,ipc-1 = <0x03 0x08 0x0d>;
		qcom,ipc-3 = <0x03 0x08 0x13>;

		apps@0 {
			reg = <0x00>;
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x38>;
		};

		hexagon@1 {
			reg = <0x01>;
			interrupts = <0x00 0x1a 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x37>;
		};

		wcnss@6 {
			reg = <0x06>;
			interrupts = <0x00 0x90 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		rng@22000 {
			compatible = "qcom,prng";
			reg = <0x22000 0x200>;
			clocks = <0x14 0x44>;
			clock-names = "core";
		};

		qfprom@5c000 {
			compatible = "qcom,qfprom";
			reg = <0x5c000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			speedbin@c {
				reg = <0x0c 0x01>;
				bits = <0x02 0x03>;
				phandle = <0x0f>;
			};

			s0-p1@a0 {
				reg = <0xa0 0x01>;
				bits = <0x00 0x06>;
				phandle = <0x1d>;
			};

			s0-p2@a0 {
				reg = <0xa0 0x02>;
				bits = <0x06 0x06>;
				phandle = <0x1e>;
			};

			s1-p1@a1 {
				reg = <0xa1 0x02>;
				bits = <0x04 0x06>;
				phandle = <0x1f>;
			};

			s1-p2@a2 {
				reg = <0xa2 0x01>;
				bits = <0x02 0x06>;
				phandle = <0x20>;
			};

			s2-p1@a3 {
				reg = <0xa3 0x01>;
				bits = <0x00 0x06>;
				phandle = <0x21>;
			};

			s2-p2@a3 {
				reg = <0xa3 0x02>;
				bits = <0x06 0x06>;
				phandle = <0x22>;
			};

			s3-p1@a4 {
				reg = <0xa4 0x02>;
				bits = <0x04 0x06>;
				phandle = <0x23>;
			};

			s3-p2@a5 {
				reg = <0xa5 0x01>;
				bits = <0x02 0x06>;
				phandle = <0x24>;
			};

			s4-p1@a6 {
				reg = <0xa6 0x01>;
				bits = <0x00 0x06>;
				phandle = <0x25>;
			};

			s4-p2@a6 {
				reg = <0xa6 0x02>;
				bits = <0x06 0x06>;
				phandle = <0x26>;
			};

			base1@dc {
				reg = <0xdc 0x01>;
				bits = <0x00 0x08>;
				phandle = <0x1b>;
			};

			base2@dd {
				reg = <0xdd 0x01>;
				bits = <0x00 0x08>;
				phandle = <0x1c>;
			};

			mode@de {
				reg = <0xde 0x01>;
				bits = <0x00 0x03>;
				phandle = <0x1a>;
			};
		};

		sram@60000 {
			compatible = "qcom,rpm-msg-ram";
			reg = <0x60000 0x8000>;
			phandle = <0x17>;
		};

		sram@290000 {
			compatible = "qcom,rpm-stats";
			reg = <0x290000 0x10000>;
		};

		thermal-sensor@4a9000 {
			compatible = "qcom,msm8909-tsens", "qcom,tsens-v0_1";
			reg = <0x4a9000 0x1000 0x4a8000 0x1000>;
			nvmem-cells = <0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26>;
			nvmem-cell-names = "mode", "base1", "base2", "s0_p1", "s0_p2", "s1_p1", "s1_p2", "s2_p1", "s2_p2", "s3_p1", "s3_p2", "s4_p1", "s4_p2";
			interrupts = <0x00 0xb8 0x04>;
			interrupt-names = "uplow";
			#thermal-sensor-cells = <0x01>;
			#qcom,sensors = <0x05>;
			phandle = <0x7e>;
		};

		restart@4ab000 {
			compatible = "qcom,pshold";
			reg = <0x4ab000 0x04>;
		};

		pinctrl@1000000 {
			compatible = "qcom,msm8909-tlmm";
			reg = <0x1000000 0x300000>;
			interrupts = <0x00 0xd0 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x27 0x00 0x00 0x75>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x27>;

			blsp-i2c1-default-state {
				pins = "gpio6", "gpio7";
				function = "blsp_i2c1";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x57>;
			};

			blsp-i2c1-sleep-state {
				pins = "gpio6", "gpio7";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x58>;
			};

			blsp-i2c2-default-state {
				pins = "gpio111", "gpio112";
				function = "blsp_i2c2";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x5b>;
			};

			blsp-i2c2-sleep-state {
				pins = "gpio111", "gpio112";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x5c>;
			};

			blsp-i2c3-default-state {
				pins = "gpio29", "gpio30";
				function = "blsp_i2c3";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x5f>;
			};

			blsp-i2c3-sleep-state {
				pins = "gpio29", "gpio30";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x60>;
			};

			blsp-i2c4-default-state {
				pins = "gpio14", "gpio15";
				function = "blsp_i2c4";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x63>;
			};

			blsp-i2c4-sleep-state {
				pins = "gpio14", "gpio15";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x64>;
			};

			blsp-i2c5-default-state {
				pins = "gpio18", "gpio19";
				function = "blsp_i2c5";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x67>;
			};

			blsp-i2c5-sleep-state {
				pins = "gpio18", "gpio19";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x68>;
			};

			blsp-i2c6-default-state {
				pins = "gpio10", "gpio11";
				function = "blsp_i2c6";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x6f>;
			};

			blsp-i2c6-sleep-state {
				pins = "gpio10", "gpio11";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x70>;
			};

			blsp-spi1-default-state {
				pins = "gpio4", "gpio5", "gpio6", "gpio7";
				function = "blsp_spi1";
				drive-strength = <0x0c>;
				bias-disable;
				phandle = <0x59>;
			};

			blsp-spi1-sleep-state {
				pins = "gpio4", "gpio5", "gpio6", "gpio7";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x5a>;
			};

			blsp-spi2-default-state {
				pins = "gpio20", "gpio21", "gpio111", "gpio112";
				function = "blsp_spi2";
				drive-strength = <0x0c>;
				bias-disable;
				phandle = <0x5d>;
			};

			blsp-spi2-sleep-state {
				pins = "gpio20", "gpio21", "gpio111", "gpio112";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x5e>;
			};

			blsp-spi3-default-state {
				pins = "gpio0", "gpio1", "gpio2", "gpio3";
				function = "blsp_spi3";
				drive-strength = <0x0c>;
				bias-disable;
				phandle = <0x61>;
			};

			blsp-spi3-sleep-state {
				pins = "gpio0", "gpio1", "gpio2", "gpio3";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x62>;
			};

			blsp-spi4-default-state {
				pins = "gpio12", "gpio13", "gpio14", "gpio15";
				function = "blsp_spi4";
				drive-strength = <0x0c>;
				bias-disable;
				phandle = <0x65>;
			};

			blsp-spi4-sleep-state {
				pins = "gpio12", "gpio13", "gpio14", "gpio15";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x66>;
			};

			blsp-spi5-default-state {
				pins = "gpio16", "gpio17", "gpio18", "gpio19";
				function = "blsp_spi5";
				drive-strength = <0x0c>;
				bias-disable;
				phandle = <0x69>;
			};

			blsp-spi5-sleep-state {
				pins = "gpio16", "gpio17", "gpio18", "gpio19";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x6a>;
			};

			blsp-spi6-default-state {
				pins = "gpio8", "gpio9", "gpio10", "gpio11";
				function = "blsp_spi6";
				drive-strength = <0x0c>;
				bias-disable;
				phandle = <0x71>;
			};

			blsp-spi6-sleep-state {
				pins = "gpio8", "gpio9", "gpio10", "gpio11";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x72>;
			};

			blsp-uart1-default-state {
				pins = "gpio4", "gpio5";
				function = "blsp_uart1";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x53>;
			};

			blsp-uart1-sleep-state {
				pins = "gpio4", "gpio5";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x54>;
			};

			blsp-uart2-default-state {
				pins = "gpio20", "gpio21";
				function = "blsp_uart2";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x55>;
			};

			blsp-uart2-sleep-state {
				pins = "gpio20", "gpio21";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x56>;
			};

			sdc1-clk-on-state {
				pins = "sdc1_clk";
				bias-disable;
				drive-strength = <0x10>;
				phandle = <0x43>;
			};

			sdc1-clk-off-state {
				pins = "sdc1_clk";
				bias-disable;
				drive-strength = <0x02>;
				phandle = <0x46>;
			};

			sdc1-cmd-on-state {
				pins = "sdc1_cmd";
				bias-disable;
				drive-strength = <0x0a>;
				phandle = <0x44>;
			};

			sdc1-cmd-off-state {
				pins = "sdc1_cmd";
				bias-disable;
				drive-strength = <0x02>;
				phandle = <0x47>;
			};

			sdc1-data-on-state {
				pins = "sdc1_data";
				bias-pull-up;
				drive-strength = <0x0a>;
				phandle = <0x45>;
			};

			sdc1-data-off-state {
				pins = "sdc1_data";
				bias-pull-up;
				drive-strength = <0x02>;
				phandle = <0x48>;
			};

			sdc2-clk-on-state {
				pins = "sdc2_clk";
				drive-strength = <0x10>;
				bias-disable;
				phandle = <0x4a>;
			};

			sdc2-clk-off-state {
				pins = "sdc2_clk";
				bias-disable;
				drive-strength = <0x02>;
				phandle = <0x4d>;
			};

			sdc2-cmd-on-state {
				pins = "sdc2_cmd";
				bias-pull-up;
				drive-strength = <0x0a>;
				phandle = <0x4b>;
			};

			sdc2-cmd-off-state {
				pins = "sdc2_cmd";
				bias-pull-up;
				drive-strength = <0x02>;
				phandle = <0x4e>;
			};

			sdc2-data-on-state {
				pins = "sdc2_data";
				bias-pull-up;
				drive-strength = <0x0a>;
				phandle = <0x4c>;
			};

			sdc2-data-off-state {
				pins = "sdc2_data";
				bias-pull-up;
				drive-strength = <0x02>;
				phandle = <0x4f>;
			};

			sdc2-cd-on-state {
				pins = "gpio38";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0x90>;
			};

			sdc2-cd-off-state {
				pins = "gpio38";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0x91>;
			};

			wcnss-active-state {
				pins = "gpio40", "gpio41", "gpio42", "gpio43", "gpio44";
				function = "wcss_wlan";
				drive-strength = <0x06>;
				bias-pull-up;
				phandle = <0x77>;
			};

			cdc-pdm-lines {

				pdm-lines-on {
					pins = "gpio59", "gpio60", "gpio61", "gpio62", "gpio63", "gpio64";
					function = "cdc_pdm0";
					drive-strength = <0x08>;
					bias-disable;
					phandle = <0x3a>;
				};

				pdm-lines-off {
					pins = "gpio59", "gpio60", "gpio61", "gpio62", "gpio63", "gpio64";
					function = "cdc_pdm0";
					drive-strength = <0x02>;
					bias-pull-down;
					phandle = <0x3b>;
				};
			};

			gpio-key-active-state {
				pins = "gpio90", "gpio98";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0x86>;
			};

			lid-switch-active-state {
				pins = "gpio36", "gpio92";
				function = "gpio";
				drive-strength = <0x06>;
				bias-pull-up;
				phandle = <0x87>;
			};

			matrix-keypad-row-gpio-state {
				pins = "gpio94", "gpio95", "gpio96", "gpio97";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-up;
				phandle = <0x88>;
			};

			matrix-keypad-col-default-state {
				pins = "gpio52", "gpio56", "gpio7", "gpio99", "gpio6";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x89>;
			};

			panel-gpios-default-state {
				pins = "gpio24", "gpio25", "gpio110";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x6e>;
			};
		};

		clock-controller@1800000 {
			compatible = "qcom,gcc-msm8909";
			reg = <0x1800000 0x80000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			clocks = <0x18 0x28 0x00 0x00>;
			clock-names = "xo", "sleep_clk", "dsi0pll", "dsi0pllbyte";
			phandle = <0x14>;
		};

		hwlock@1905000 {
			compatible = "qcom,tcsr-mutex";
			reg = <0x1905000 0x20000>;
			#hwlock-cells = <0x01>;
			phandle = <0x16>;
		};

		syscon@1937000 {
			compatible = "qcom,tcsr-msm8909", "syscon";
			reg = <0x1937000 0x30000>;
			phandle = <0x15>;
		};

		gpu: gpu@1c00000 {
			compatible = "qcom,adreno-304.0", "qcom,adreno";
			reg = <0x01c00000 0x20000>;
			reg-names = "kgsl_3d0_reg_memory";
			interrupts = <0x00 33 0x04>;
			interrupt-names = "kgsl_3d0_irq";
			clock-names = "core", "iface", "mem_iface", "alt_mem_iface", "gtcu_iface", "gfx3d";
			clocks = <0x14 124>, <0x14 123>, <0x14 72>, <0x14 73>, <0x14 66>, <0x14 35>;
			power-domains = <0x14 1>;
			operating-points-v2 = <&gpu_opp_table>;
			iommus = <&gpu_iommu 1>, <&gpu_iommu 2>;
			#cooling-cells = <2>;

			gpu_opp_table: opp-table {
				compatible = "operating-points-v2";

				opp-409600000 {
					opp-hz = /bits/ 64 <409600000>;
				};
				opp-307200000 {
					opp-hz = /bits/ 64 <307200000>;
				};
				opp-200000000 {
					opp-hz = /bits/ 64 <200000000>;
				};
				opp-19200000 {
					opp-hz = /bits/ 64 <19200000>;
				};
			};
		};

		gpu_iommu: iommu@1f08000 {
			#address-cells = <1>;
			#size-cells = <1>;
			#iommu-cells = <1>;
			compatible = "qcom,msm8909-iommu", "qcom,msm8916-iommu", "qcom,msm-iommu-v1";
			ranges = <0 0x01f08000 0x10000>;
			clocks = <0x14 69>, <0x14 65>, <0x14 64>;
			clock-names = "iface", "bus", "tbu";
			qcom,iommu-secure-id = <18>;

			iommu-ctx@1000 {
				compatible = "qcom,msm-iommu-v1-ns";
				reg = <0x1000 0x1000>;
				interrupts = <0x00 241 0x04>;
			};

			iommu-ctx@2000 {
				compatible = "qcom,msm-iommu-v1-ns";
				reg = <0x2000 0x1000>;
				interrupts = <0x00 242 0x04>;
			};
		};

		spmi@200f000 {
			compatible = "qcom,spmi-pmic-arb";
			reg = <0x200f000 0x1000 0x2400000 0x400000 0x2c00000 0x400000 0x3800000 0x200000 0x200a000 0x2100>;
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
			interrupt-names = "periph_irq";
			interrupts = <0x00 0xbe 0x04>;
			qcom,ee = <0x00>;
			qcom,channel = <0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;
			phandle = <0x2e>;

			pmic@0 {
				compatible = "qcom,pm8909", "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pon@800 {
					compatible = "qcom,pm8916-pon";
					reg = <0x800>;
					mode-bootloader = <0x02>;
					mode-recovery = <0x01>;

					pwrkey {
						compatible = "qcom,pm8941-pwrkey";
						interrupts = <0x00 0x08 0x00 0x03>;
						debounce = <0x3d09>;
						bias-pull-up;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pm8941-resin";
						interrupts = <0x00 0x08 0x01 0x03>;
						debounce = <0x3d09>;
						bias-pull-up;
						status = "okay";
						linux,code = <0x6c>;
					};

					watchdog {
						compatible = "qcom,pm8916-wdt";
						interrupts = <0x00 0x08 0x06 0x01>;
						timeout-sec = <0x3c>;
					};
				};

				charger@1000 {
					compatible = "qcom,pm8916-lbc";
					reg = <0x1000 0x1200 0x1300 0x1600>;
					reg-names = "chgr", "bat_if", "usb", "misc";
					interrupts = <0x00 0x10 0x00 0x03 0x00 0x10 0x05 0x03 0x00 0x10 0x06 0x03 0x00 0x10 0x07 0x03 0x00 0x12 0x00 0x03 0x00 0x12 0x01 0x03 0x00 0x13 0x00 0x03 0x00 0x13 0x01 0x03 0x00 0x13 0x02 0x03 0x00 0x13 0x04 0x03>;
					interrupt-names = "vbat_det", "fast_chg", "chg_fail", "chg_done", "bat_pres", "temp_ok", "coarse_det", "usb_vbus", "chg_gone", "overtemp";
					status = "okay";
					qcom,fast-charge-safe-current = <0x57e40>;
					qcom,fast-charge-safe-voltage = <0x426030>;
					monitored-battery = <0x29>;
					phandle = <0x2a>;
				};

				extcon@1300 {
					compatible = "qcom,pm8941-misc";
					reg = <0x1300>;
					interrupts = <0x00 0x13 0x01 0x03>;
					interrupt-names = "usb_vbus";
					status = "disabled";
				};

				vm-bms@4000 {
					compatible = "qcom,pm8916-bms-vm";
					reg = <0x4000>;
					interrupts = <0x00 0x40 0x00 0x01 0x00 0x40 0x01 0x01 0x00 0x40 0x02 0x01 0x00 0x40 0x03 0x01 0x00 0x40 0x04 0x01 0x00 0x40 0x05 0x01>;
					interrupt-names = "cv_leave", "cv_enter", "ocv_good", "ocv_thr", "fifo", "state_chg";
					status = "okay";
					monitored-battery = <0x29>;
					power-supplies = <0x2a>;
				};

				rtc@6000 {
					compatible = "qcom,pm8941-rtc";
					reg = <0x6000>;
					interrupts = <0x00 0x61 0x01 0x01>;
				};

				mpps@a000 {
					compatible = "qcom,pm8916-mpp", "qcom,spmi-mpp";
					reg = <0xa000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x2b 0x00 0x00 0x04>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x2b>;

					mpp2-state {
						pins = "mpp2";
						function = "digital";
						power-source = <0x00>;
						output-low;
						qcom,dtest = <0x01>;
						phandle = <0x2d>;
					};
				};

				gpios@c000 {
					compatible = "qcom,pm8916-gpio", "qcom,spmi-gpio";
					reg = <0xc000>;
					gpio-controller;
					gpio-ranges = <0x2c 0x00 0x00 0x04>;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x2c>;

					keypad-backlight-default-state {
						pins = "gpio1";
						function = "normal";
						output-low;
						power-source = <0x03>;
						phandle = <0x8a>;
					};
				};
			};

			pmic@1 {
				compatible = "qcom,pm8909", "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pwm {
					compatible = "qcom,pm8916-pwm";
					#pwm-cells = <0x02>;
					status = "okay";
					pinctrl-0 = <0x2d>;
					pinctrl-names = "default";
					phandle = <0x85>;
				};

				vibrator@c000 {
					compatible = "qcom,pm8916-vib";
					reg = <0xc000>;
					status = "okay";
				};

				audio-codec@f000 {
					compatible = "qcom,pm8916-wcd-analog-codec";
					reg = <0xf000>;
					reg-names = "pmic-codec-core";
					interrupt-parent = <0x2e>;
					interrupts = <0x01 0xf0 0x00 0x00 0x01 0xf0 0x01 0x00 0x01 0xf0 0x02 0x00 0x01 0xf0 0x03 0x00 0x01 0xf0 0x04 0x00 0x01 0xf0 0x05 0x00 0x01 0xf0 0x06 0x00 0x01 0xf0 0x07 0x00 0x01 0xf1 0x00 0x00 0x01 0xf1 0x01 0x00 0x01 0xf1 0x02 0x00 0x01 0xf1 0x03 0x00 0x01 0xf1 0x04 0x00 0x01 0xf1 0x05 0x00>;
					interrupt-names = "cdc_spk_cnp_int", "cdc_spk_clip_int", "cdc_spk_ocp_int", "mbhc_ins_rem_det1", "mbhc_but_rel_det", "mbhc_but_press_det", "mbhc_ins_rem_det", "mbhc_switch_int", "cdc_ear_ocp_int", "cdc_hphr_ocp_int", "cdc_hphl_ocp_det", "cdc_ear_cnp_int", "cdc_hphr_cnp_int", "cdc_hphl_cnp_int";
					#sound-dai-cells = <0x01>;
					status = "okay";
					qcom,hphl-jack-type-normally-open;
					qcom,micbias1-ext-cap;
					qcom,micbias2-ext-cap;
					qcom,mbhc-vthreshold-low = <0x55 0x78 0xe1 0x1c2 0x1f4>;
					qcom,mbhc-vthreshold-high = <0x55 0x78 0xe1 0x1c2 0x1f4>;
					vdd-cdc-io-supply = <0x2f>;
					vdd-cdc-tx-rx-cx-supply = <0x30>;
					vdd-micbias-supply = <0x31>;
					phandle = <0x41>;
				};
			};
		};

		dma-controller@4044000 {
			compatible = "qcom,bam-v1.7.0";
			reg = <0x4044000 0x19000>;
			interrupts = <0x00 0x1d 0x04>;
			#dma-cells = <0x01>;
			qcom,ee = <0x00>;
			num-channels = <0x06>;
			qcom,num-ees = <0x01>;
			qcom,powered-remotely;
			phandle = <0x39>;
		};

		remoteproc@4080000 {
			compatible = "qcom,msm8909-mss-pil";
			reg = <0x4080000 0x100 0x4020000 0x40>;
			reg-names = "qdsp6", "rmb";
			interrupts-extended = <0x01 0x00 0x18 0x01 0x32 0x00 0x01 0x32 0x01 0x01 0x32 0x02 0x01 0x32 0x03 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
			power-domains = <0x04 0x00 0x04 0x04>;
			power-domain-names = "cx", "mx";
			clocks = <0x14 0x79 0x14 0x7a 0x14 0x3c 0x18>;
			clock-names = "iface", "bus", "mem", "xo";
			qcom,smem-states = <0x33 0x00>;
			qcom,smem-state-names = "stop";
			resets = <0x14 0x29>;
			reset-names = "mss_restart";
			qcom,halt-regs = <0x15 0x18000 0x19000 0x1a000>;
			status = "okay";
			pll-supply = <0x34>;

			mba {
				memory-region = <0x35>;
			};

			mpss {
				memory-region = <0x36>;
			};

			bam-dmux {
				compatible = "qcom,bam-dmux";
				interrupt-parent = <0x37>;
				interrupts = <0x01 0x03 0x0b 0x03>;
				interrupt-names = "pc", "pc-ack";
				qcom,smem-states = <0x38 0x01 0x38 0x0b>;
				qcom,smem-state-names = "pc", "pc-ack";
				dmas = <0x39 0x04 0x39 0x05>;
				dma-names = "tx", "rx";
			};

			smd-edge {
				interrupts = <0x00 0x19 0x01>;
				qcom,smd-edge = <0x00>;
				qcom,ipc = <0x03 0x08 0x0c>;
				qcom,remote-pid = <0x01>;
				label = "hexagon";

				apr {
					compatible = "qcom,apr-v2";
					qcom,smd-channels = "apr_audio_svc";
					qcom,apr-domain = <0x04>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					status = "okay";

					apr-service@3 {
						reg = <0x03>;
						compatible = "qcom,q6core";
					};

					apr-service@4 {
						compatible = "qcom,q6afe";
						reg = <0x04>;

						dais {
							compatible = "qcom,q6afe-dais";
							#address-cells = <0x01>;
							#size-cells = <0x00>;
							#sound-dai-cells = <0x01>;
							phandle = <0x3e>;

							dai@16 {
								reg = <0x10>;
								qcom,sd-lines = <0x00 0x01>;
							};

							dai@20 {
								reg = <0x15>;
								qcom,sd-lines = <0x00 0x01>;
							};
						};

						clock-controller {
							compatible = "qcom,q6afe-clocks";
							#clock-cells = <0x02>;
							phandle = <0x42>;
						};
					};

					apr-service@7 {
						compatible = "qcom,q6asm";
						reg = <0x07>;

						dais {
							compatible = "qcom,q6asm-dais";
							#address-cells = <0x01>;
							#size-cells = <0x00>;
							#sound-dai-cells = <0x01>;
							phandle = <0x3c>;

							dai@0 {
								reg = <0x00>;
								direction = <0x02>;
							};

							dai@1 {
								reg = <0x01>;
								direction = <0x01>;
							};

							dai@2 {
								reg = <0x02>;
								direction = <0x02>;
							};

							dai@3 {
								reg = <0x03>;
								direction = <0x02>;
								is-compress-dai;
							};
						};
					};

					apr-service@8 {
						compatible = "qcom,q6adm";
						reg = <0x08>;

						routing {
							compatible = "qcom,q6adm-routing";
							#sound-dai-cells = <0x00>;
							phandle = <0x3f>;
						};
					};

					apr-service@9 {
						compatible = "qcom,q6mvm";
						reg = <0x09>;

						dais {
							compatible = "qcom,q6voice-dais";
							#sound-dai-cells = <0x01>;
							phandle = <0x3d>;
						};
					};

					apr-service@a {
						compatible = "qcom,q6cvs";
						reg = <0x0a>;
					};

					apr-service@b {
						compatible = "qcom,q6cvp";
						reg = <0x0b>;
					};
				};
			};
		};

		sound@7702000 {
