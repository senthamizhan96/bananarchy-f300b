		power-manager@b0a8000 {
			compatible = "qcom,msm8909-acc";
			reg = <0xb0a8000 0x1000>;
			phandle = <0x0b>;
		};

		power-manager@b0a9000 {
			compatible = "qcom,msm8909-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb0a9000 0x1000>;
			phandle = <0x0c>;
		};

		power-manager@b0b8000 {
			compatible = "qcom,msm8909-acc";
			reg = <0xb0b8000 0x1000>;
			phandle = <0x0d>;
		};

		power-manager@b0b9000 {
			compatible = "qcom,msm8909-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb0b9000 0x1000>;
			phandle = <0x0e>;
		};
	};

	thermal-zones {

		cpu0-2-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x7e 0x03>;

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x7f>;
				};

				cpu_crit {
					temperature = <0x186a0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x7f>;
					cooling-device = <0x80 0xffffffff 0xffffffff 0x81 0xffffffff 0xffffffff 0x82 0xffffffff 0xffffffff 0x83 0xffffffff 0xffffffff>;
				};
			};
		};

		cpu1-3-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x7e 0x04>;

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x84>;
				};

				cpu_crit {
					temperature = <0x186a0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x84>;
					cooling-device = <0x80 0xffffffff 0xffffffff 0x81 0xffffffff 0xffffffff 0x82 0xffffffff 0xffffffff 0x83 0xffffffff 0xffffffff>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x7e 0x02>;

			trips {

				trip-point0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "hot";
				};
			};
		};

		camera-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x7e 0x01>;

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "hot";
				};
			};
		};

		modem-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x7e 0x00>;

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "hot";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x04 0xf08 0x01 0x01 0xf08>;
	};

	backlight {
		compatible = "pwm-backlight";
		pwms = <0x85 0x00 0x186a0>;
		brightness-levels = <0x00 0x04 0x08 0x10 0x20 0x40 0x80 0xff>;
		num-interpolated-steps = <0x02>;
		default-brightness-level = <0x0a>;
		phandle = <0x6b>;
	};

	battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <0x33e140>;
		voltage-max-design-microvolt = <0x432380>;
		energy-full-design-microwatt-hours = <0x594390>;
		charge-full-design-microamp-hours = <0x16e360>;
		ocv-capacity-celsius = <0x19>;
		ocv-capacity-table-0 = <0x42d560 0x64 0x417da0 0x5f 0x409b10 0x5a 0x3fef30 0x55 0x3f7230 0x50 0x3ef148 0x4b 0x3e6890 0x46 0x3da540 0x41 0x3cda20 0x3c 0x3c45b0 0x37 0x3be408 0x32 0x3b3440 0x2d 0x3a9800 0x28 0x39fbc0 0x23 0x39bd40 0x1e 0x396368 0x19 0x391d18 0x14 0x38cb10 0x10 0x387cf0 0x0d 0x384e10 0x0b 0x384640 0x0a 0x384258 0x09 0x383a88 0x08 0x3832b8 0x07 0x381b48 0x06 0x37c940 0x05 0x371d60 0x04 0x363ad0 0x03 0x34d370 0x02 0x32b090 0x01 0x2dc6c0 0x00>;
		phandle = <0x29>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x86 0x87>;
		pinctrl-names = "default";

		key-up {
			wakeup-source;
			gpios = <0x27 0x5a 0x01>;
			linux,code = <0x67>;
			debounce-interval = <0x0f>;
			linux,can-disable;
		};

		key-back {
			wakeup-source;
			gpios = <0x27 0x62 0x01>;
			linux,code = <0x0e>;
			debounce-interval = <0x0f>;
			linux,can-disable;
		};

		switch-lid-close {
			wakeup-source;
			gpios = <0x27 0x5c 0x01>;
			linux,input-type = <0x05>;
			linux,code = <0x00>;
		};

		switch-lid-open {
			gpios = <0x27 0x24 0x01>;
			linux,input-type = <0x05>;
			linux,code = <0x0a>;
		};
	};

	keypad {
		compatible = "gpio-matrix-keypad";
		col-scan-delay-ms = <0x07>;
		debounce-delay-ms = <0x0a>;
		gpio-activelow;
		pinctrl-0 = <0x88 0x89>;
		pinctrl-names = "default";
		row-gpios = <0x27 0x61 0x01 0x27 0x60 0x01 0x27 0x5f 0x01 0x27 0x5e 0x01>;
		col-gpios = <0x27 0x34 0x01 0x27 0x38 0x01 0x27 0x07 0x01 0x27 0x63 0x01 0x27 0x06 0x01>;
		linux,keymap = <0x1bd 0x10002 0x20005 0x30008 0x4020a 0x1000069 0x1010003 0x1020006 0x1030009 0x104000b 0x20002b8 0x2010004 0x2020007 0x203000a 0x204020b 0x300001c 0x301006a 0x30202b9>;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <0x8a>;
		pinctrl-names = "default";

		led-0 {
			function = "kbd_backlight";
			color = <0x00>;
			gpios = <0x2c 0x01 0x00>;
		};
	};
};
